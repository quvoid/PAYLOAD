# Neon — pooled connection string (Connection pooling ON). Used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon — direct connection string (Connection pooling OFF). For migrations / schema work.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site origin, used for canonicals, sitemaps and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob store for uploaded images. Vercel sets this when you connect a Blob store;
# leave it unset locally and images are saved to /media instead.
BLOB_READ_WRITE_TOKEN=
